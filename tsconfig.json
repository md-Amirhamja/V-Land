{
  "compilerOptions": {
    "target": "ES2021", "lib": ["ES2021", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": false, "noImplicitAny": false,
    "strictNullChecks": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "esModuleInterop": true,
    "baseUrl": ".", "paths": { "@/*": ["src/app/*"] }, "types": ["vite/client", "node"]
  },
  "include": ["src/app/**/*", "src/vite-env.d.ts"]
}
