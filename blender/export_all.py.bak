import re, numpy as np
from collections import Counter

BASE = "/Users/amir/Downloads/bangladesh-3d-web"
OUT = BASE + "/public/models/"
REPORT = BASE + "/blender/export_report.txt"
DIVS = ["Dhaka", "Chittagong", "Khulna", "Rajshahi", "Barisal", "Sylhet", "Rangpur", "Mymensingh"]
log = []
def say(s):
    log.append(str(s)); print(s)


def nn(q, p, chunk=256):
    q = q.astype(np.float32); p = p.astype(np.float32)
    p2 = (p * p).sum(1)
    idx = np.empty(len(q), dtype=np.int64); dist = np.empty(len(q), dtype=np.float32)
    for i in range(0, len(q), chunk):
        qc = q[i:i + chunk]
        d = (qc * qc).sum(1)[:, None] + p2[None, :] - 2 * qc @ p.T
        j = d.argmin(1)
        idx[i:i + chunk] = j
        dist[i:i + chunk] = np.sqrt(np.maximum(d[np.arange(len(qc)), j], 0))
    return idx, dist

def apply(M, pts):
    return np.hstack([pts, np.ones((len(pts), 1))]) @ M

def affine_fit(src, dst):
    X = np.hstack([src, np.ones((len(src), 1))])
    M, *_ = np.linalg.lstsq(X, dst, rcond=None)
    return M

def normalise(P, lo_hi=None):
    if lo_hi is None:
        lo_hi = (np.percentile(P, 0.3, axis=0), np.percentile(P, 99.7, axis=0))
    lo, hi = lo_hi
    return (P - lo) / (hi - lo)

def outline(P, g=160, lo=-0.15, hi=1.15):
    ij = np.floor((P - lo) / (hi - lo) * g).astype(int)
    ok = ((ij >= 0) & (ij < g)).all(1)
    ij = ij[ok]
    grid = np.zeros((g, g), bool); grid[ij[:, 0], ij[:, 1]] = True
    def dil(m):
        o = m.copy(); o[1:] |= m[:-1]; o[:-1] |= m[1:]; o[:, 1:] |= m[:, :-1]; o[:, :-1] |= m[:, 1:]; return o
    def ero(m): return ~dil(~m)
    grid = ero(dil(dil(grid)))
    edge = grid & ~ero(grid)
    xs, ys = np.nonzero(edge)
    return np.column_stack([lo + (xs + 0.5) / g * (hi - lo), lo + (ys + 0.5) / g * (hi - lo)])

def align(A, D, rng, log=print):
    A = A[(A > -0.4).all(1) & (A < 1.4).all(1)]
    a_o, d_o = outline(A), outline(D)
    log("  outline points: areas %d, districts %d" % (len(a_o), len(d_o)))
    cands = {
        "same":       np.array([[1, 0], [0, 1], [0, 0]], float),
        "flip-y":     np.array([[1, 0], [0, -1], [0, 1]], float),
        "flip-x":     np.array([[-1, 0], [0, 1], [1, 0]], float),
        "rotate-180": np.array([[-1, 0], [0, -1], [1, 1]], float),
    }
    best = None
    for name, M in cands.items():
        for it in range(100):
            Ta = apply(M, a_o)
            ia, da = nn(Ta, d_o)
            ib, db = nn(d_o, Ta)
            ka = da <= np.quantile(da, 0.85)
            kb = db <= np.quantile(db, 0.85)
            M = affine_fit(np.vstack([a_o[ka], a_o[ib][kb]]), np.vstack([d_o[ia][ka], d_o[kb]]))
        Ta = apply(M, a_o)
        _, da = nn(Ta, d_o); _, db = nn(d_o, Ta)
        score = float((np.median(da) + np.median(db)) / 2)
        log("  alignment '%s': residual %.5f" % (name, score))
        if best is None or score < best[0]:
            best = (score, name, M)
    log("  alignment chosen: %s (residual %.5f)" % (best[1], best[0]))
    return best[2]

def tri_area(T):
    return 0.5 * np.abs((T[:,1,0]-T[:,0,0])*(T[:,2,1]-T[:,0,1]) - (T[:,2,0]-T[:,0,0])*(T[:,1,1]-T[:,0,1]))

def sample_tris(T, n, rng):
    a = tri_area(T); tot = a.sum()
    if tot <= 0:
        return np.repeat(T.reshape(-1, 2).mean(0, keepdims=True), n, axis=0)
    idx = rng.choice(len(T), size=n, p=a / tot)
    r1 = np.sqrt(rng.random(n)); r2 = rng.random(n)
    A, B, C = T[idx, 0], T[idx, 1], T[idx, 2]
    return (1 - r1)[:, None] * A + (r1 * (1 - r2))[:, None] * B + (r1 * r2)[:, None] * C

def match_areas(areas_T, dists_T, log):
    rng = np.random.default_rng(7)
    da = np.array([tri_area(T).sum() for T in dists_T]); da = da / da.sum()
    D, DL = [], []
    for i, T in enumerate(dists_T):
        P = sample_tris(T, max(40, int(da[i] * 80000)), rng); D.append(P); DL.append(np.full(len(P), i))
    D = np.vstack(D); DL = np.concatenate(DL)
    aa = np.array([tri_area(T).sum() for T in areas_T]); aa = aa / aa.sum()
    A, offs = [], [0]
    for T in areas_T:
        n = max(25, int(aa[len(offs) - 1] * 30000))
        A.append(sample_tris(T, n, rng)); offs.append(offs[-1] + n)
    A = np.vstack(A)
    Dn = normalise(D)
    An = normalise(A)
    M = align(An, Dn, rng, log)
    Ta = apply(M, An)
    idx, dist = nn(Ta, Dn, chunk=64)
    labs = DL[idx]
    assign, purity = [], []
    for k in range(len(areas_T)):
        l = labs[offs[k]:offs[k + 1]]
        c = np.bincount(l, minlength=len(dists_T))
        assign.append(int(c.argmax())); purity.append(float(c.max() / len(l)))
    return assign, purity

# ==================== Blender part ====================
import bpy

def clean(s):
    s = re.sub(r'\.\d{3}$', '', s)
    s = s.replace("'", "").replace(".", "").replace(" ", "_")
    return re.sub(r'_+', '_', s).strip('_')

def meshes(c):
    return [o for o in c.objects if o.type == 'MESH']

divisions, districts, areas = [], [], []

bd = bpy.data.collections.get("Bangladesh")
seen = {}
for o in meshes(bd):
    b = clean(o.name)
    if b in DIVS and (b not in seen or o.name == b):
        seen[b] = o
    elif b not in DIVS:
        say("IGNORED in Bangladesh collection: " + o.name)
for b, o in seen.items():
    divisions.append(dict(obj=o, div=b))
say("Divisions found (%d): %s" % (len(divisions), sorted(seen)))
say("Divisions missing: %s" % sorted(set(DIVS) - set(seen)))

for c in bpy.data.collections:
    if c.name in ("Collection", "Bangladesh"):
        continue
    if c.name.endswith("_Districts"):
        div = c.name[:-len("_Districts")]
        for o in meshes(c):
            d = re.sub(r'_District$', '', clean(o.name))
            districts.append(dict(obj=o, div=div, dist=d))
    elif c.name in DIVS:
        for o in meshes(c):
            n = clean(o.name)
            d = n[len(c.name) + 1:] if n.startswith(c.name + "_") else n
            districts.append(dict(obj=o, div=c.name, dist=d))
say("Districts found: %d (expected 64)" % len(districts))

for o in meshes(bpy.data.collections["Collection"]):
    areas.append(dict(obj=o, name=clean(o.name)))
say("Areas found: %d" % len(areas))

def tris(o):
    me = o.data
    me.calc_loop_triangles()
    v = np.empty(len(me.vertices) * 3, dtype=np.float32)
    me.vertices.foreach_get('co', v)
    v = v.reshape(-1, 3).astype(np.float64)
    t = np.empty(len(me.loop_triangles) * 3, dtype=np.int32)
    me.loop_triangles.foreach_get('vertices', t)
    t = t.reshape(-1, 3)
    M = np.array(o.matrix_world)
    w = v @ M[:3, :3].T + M[:3, 3]
    return w[t][:, :, :2]

say("Aligning the area map with the district map...")
assign, purity = match_areas([tris(a['obj']) for a in areas], [tris(d['obj']) for d in districts], say)
for a, i, p in zip(areas, assign, purity):
    a['di'] = i; a['purity'] = p
low = [a for a in areas if a['purity'] < 0.6]
say("Areas on a district border (low confidence, purity < 0.6): %d" % len(low))
for a in low[:40]:
    d = districts[a['di']]
    say("   %s -> %s / %s  (%.2f)" % (a['name'], d['div'], d['dist'], a['purity']))

used = set()
def uniq(n):
    base, i = n, 2
    while n in used:
        n = "%s_%d" % (base, i); i += 1
    used.add(n)
    return n

count = Counter()
for a in areas:
    d = districts[a['di']]
    count[(d['div'], d['dist'])] += 1
    a['obj'].name = uniq("%s__%s__%s" % (d['div'], d['dist'], a['name']))
for d in districts:
    d['obj'].name = uniq("%s__%s" % (d['div'], d['dist']))
for v in divisions:
    v['obj'].name = v['div']

say("--- areas per district ---")
zero = 0
for d in districts:
    n = count[(d['div'], d['dist'])]
    zero += (n == 0)
    say("%s / %s : %d" % (d['div'], d['dist'], n))
say("Districts with 0 areas: %d" % zero)

def export(items, fname):
    bpy.ops.object.select_all(action='DESELECT')
    for it in items:
        o = it['obj']
        try:
            o.hide_set(False)
        except Exception:
            pass
        o.hide_viewport = False
        o.select_set(True)
    bpy.context.view_layer.objects.active = items[0]['obj']
    bpy.ops.export_scene.gltf(filepath=OUT + fname, export_format='GLB',
                              use_selection=True, export_apply=False,
                              export_yup=True, export_materials='EXPORT')
    say("saved " + OUT + fname)

export(divisions, "divisions.glb")
export(districts, "districts.glb")
export(areas, "areas.glb")

open(REPORT, "w").write("\n".join(log))
